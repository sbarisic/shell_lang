<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\shell_lang\shell_lang.csproj" />
    <ProjectReference Include="..\shell_lang_test_support\shell_lang_test_support.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\README.md" Link="README.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\LANGUAGE.md" Link="LANGUAGE.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\EXAMPLE.md" Link="EXAMPLE.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\EVENTS.md" Link="EVENTS.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
